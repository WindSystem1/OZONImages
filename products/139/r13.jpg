var offer_details={"content":"<div id=\"offer-template-0\"></div><p><span style=\"font-size: 16.0pt;color: #ff0000;\"><span style=\"font-size: 16.0pt;\">成品尺寸：</span><span style=\"font-size: 16.0pt;\">34*25*26.5CM</span><span style=\"font-size: 16.0pt;\">；</span></span></p>\r\n<p><span style=\"font-size: 16.0pt;color: #ff0000;\">单盒重量：1.9kg；</span></p>\r\n<p><span style=\"font-size: 16.0pt;color: #ff0000;\">单盒尺寸：<span>36*8.5*32CM</span>；</span></p>\r\n<p><span style=\"font-size: 16.0pt;color: #ff0000;\">装箱尺寸：<span>70*38*34CM（8盒/箱）</span></span></p>\r\n<p><span style=\"font-size: 16.0pt;color: #ff0000;\">装箱规格：一箱8盒！</span></p>\r\n<p><span style=\"font-size: 16.0pt;color: #ff0000;\">&nbsp;</span></p>\r\n<p><span style=\"font-size: 16.0pt;color: #ff0000;\">此款不带防尘罩，标配：材料包+LED灯+电池盒开关+1支白乳胶<span style=\"background-color: #ffff00;\">（英文版不带胶水，如需要请联系客服或备注）</span>。</span></p>\r\n<p><span style=\"font-size: 16.0pt;\">音乐机芯（大号），工具胶水公仔等配件，需另购。</span></p>\r\n<p><span style=\"font-size: 16.0pt;\">此款为大型小屋，建议2瓶胶水</span></p>\r\n<p><span style=\"font-size: 16.0pt;\">&nbsp;</span></p>\r\n<p><span style=\"font-size: 16.0pt;\">工具。胶水，配件链接：</span></p>\r\n<p><span style=\"font-size: 16.0pt;\"><a href=\"https://detail.1688.com/offer/621727216879.html?spm=a26286.8251493.description.2.221425b2WBIGaZ\" target=\"_blank\">https://detail.1688.com/offer/621727216879.html?spm=a26286.8251493.description.2.221425b2WBIGaZ</a></span></p>\r\n<p><span style=\"font-size: 16.0pt;\">音乐机芯链接：</span></p>\r\n<p><span style=\"font-size: 16.0pt;\"><a href=\"https://detail.1688.com/offer/621727700788.html?spm=a2615.7691456.autotrace-offerGeneral.1.2676ivNDivNDXn\" target=\"_blank\">https://detail.1688.com/offer/621727700788.html?spm=a2615.7691456.autotrace-offerGeneral.1.2676ivNDivNDXn</a></span></p>\r\n<p><span style=\"font-size: 16.0pt;\">人偶公仔链接：</span></p>\r\n<p><span style=\"font-size: 16.0pt;\"><a href=\"https://detail.1688.com/offer/622098261430.html?spm=a26286.8251493.description.2.221425b2WBIGaZ\" target=\"_blank\">https://detail.1688.com/offer/622098261430.html?spm=a26286.8251493.description.2.221425b2WBIGaZ</a></span></p>\r\n<p><span style=\"font-size: 16.0pt;\">&nbsp; &nbsp; 因diy小屋零件较多，只能人工分装，少数产品可能有零部件遗漏，因批发利润微薄，需补材料的批发客户请统计好需要补发的零部件编号（具体编号参考说明书）和数量，下次订货时一起发出！客人做坏了材料，需要单独补的，请拍补材料的链接，联系客服补发！谢谢理解和支持！</span></p>\r\n<p><img src=\"https://cbu01.alicdn.com/img/ibank/O1CN01rg2a4N2Hpentr40aY_!!2208368159200-0-cib.jpg?__r__=1728787193312\" alt=\"详情页_01.jpg\"/><br class=\"img-brk\"/><br class=\"img-brk\"/><img src=\"https://cbu01.alicdn.com/img/ibank/O1CN01L64Ksb2HpenwKeNcX_!!2208368159200-0-cib.jpg?__r__=1728787193313\" alt=\"详情页_02.jpg\"/><br class=\"img-brk\"/><br class=\"img-brk\"/><img src=\"https://cbu01.alicdn.com/img/ibank/O1CN01DFLc2B2HpenwKf7MH_!!2208368159200-0-cib.jpg?__r__=1728787193313\" alt=\"详情页_03.jpg\"/><br class=\"img-brk\"/><br class=\"img-brk\"/><img src=\"https://cbu01.alicdn.com/img/ibank/O1CN01LRui922HpenxOts3q_!!2208368159200-0-cib.jpg?__r__=1728787193313\" alt=\"详情页_04.jpg\"/><br class=\"img-brk\"/><br class=\"img-brk\"/><img src=\"https://cbu01.alicdn.com/img/ibank/O1CN01Wp5DYX2HpenuQ6t2D_!!2208368159200-0-cib.jpg?__r__=1728787193313\" alt=\"详情页_05.jpg\"/><br class=\"img-brk\"/><br class=\"img-brk\"/><img src=\"https://cbu01.alicdn.com/img/ibank/O1CN01sWGm2a2HpentmZTGO_!!2208368159200-0-cib.jpg?__r__=1728787193313\" alt=\"详情页_06.jpg\"/><br class=\"img-brk\"/><br class=\"img-brk\"/><img src=\"https://cbu01.alicdn.com/img/ibank/O1CN010c3WCT2Hpenw96Fvj_!!2208368159200-0-cib.jpg?__r__=1728787193313\" alt=\"详情页_07.jpg\"/><br class=\"img-brk\"/><br class=\"img-brk\"/><img src=\"https://cbu01.alicdn.com/img/ibank/O1CN01RuIwY92HpenwrnlnD_!!2208368159200-0-cib.jpg?__r__=1728787193313\" alt=\"详情页_08.jpg\"/><br class=\"img-brk\"/><br class=\"img-brk\"/><img src=\"https://cbu01.alicdn.com/img/ibank/O1CN018Ywfwb2HpenrXAEk2_!!2208368159200-0-cib.jpg?__r__=1728787193313\" alt=\"详情页_09.jpg\"/><br class=\"img-brk\"/><br class=\"img-brk\"/><img src=\"https://cbu01.alic