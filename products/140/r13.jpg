var offer_details={"content":"<div id=\"offer-template-0\"></div><p><span style=\"font-size: 16.0pt;color: #ff0000;\">成品尺寸：22.9*16.3*20CM；</span></p>\r\n<p><span style=\"font-size: 16.0pt;color: #ff0000;\">单盒尺寸：27.5*4.5*23.5CM；</span></p>\r\n<p><span style=\"font-size: 16.0pt;color: #ff0000;\">单盒重量：1.2KG；</span></p>\r\n<p><span style=\"font-size: 16.0pt;color: #ff0000;\">装箱尺寸：39*29.5*50CM；</span></p>\r\n<p><span style=\"font-size: 16.0pt;color: #ff0000;\">装箱规格：一箱16盒！</span></p>\r\n<p><span style=\"font-size: 16.0pt;color: #ff0000;\">&nbsp;</span></p>\r\n<p><span style=\"font-size: 16.0pt;color: #ff0000;\">此款不带防尘罩，标配：全彩说明书、触控电源套装+5个LED灯+30ML<span style=\"background-color: #ffff00;\">（手工胶英文版不带胶水，如需要请联系客服或备注）</span></span></p>\r\n<p>&nbsp;</p>\r\n<p><span style=\"font-size: 16.0pt;\">工具。胶水，配件链接：</span></p>\r\n<p><span style=\"font-size: 16.0pt;\"><a href=\"https://detail.1688.com/offer/621727216879.html?spm=a26286.8251493.description.2.221425b2WBIGaZ\" target=\"_blank\">https://detail.1688.com/offer/621727216879.html?spm=a26286.8251493.description.2.221425b2WBIGaZ</a></span></p>\r\n<p><span style=\"font-size: 16.0pt;\">&nbsp;</span></p>\r\n<p><span style=\"font-size: 16.0pt;\">&nbsp; &nbsp; 因diy小屋零件较多，只能人工分装，少数产品可能有零部件遗漏，因批发利润微薄，需补材料的批发客户请统计好需要补发的零部件编号（具体编号参考说明书）和数量，下次订货时一起发出！客人做坏了材料，需要单独补的，请拍补材料的链接，联系客服补发！谢谢理解和支持！</span></p>\r\n<p><img src=\"https://cbu01.alicdn.com/img/ibank/O1CN01cbcHaJ2HpexPcBbOZ_!!2208368159200-0-cib.jpg\"/></p>\r\n<p><img src=\"https://cbu01.alicdn.com/img/ibank/O1CN01b1hmrU2HpexPm69gn_!!2208368159200-0-cib.jpg\"/></p>\r\n<p><img src=\"https://cbu01.alicdn.com/img/ibank/O1CN0119kvTm2HpexQNI7KT_!!2208368159200-0-cib.jpg\"/></p>\r\n<p><img src=\"https://cbu01.alicdn.com/img/ibank/O1CN01nlRi172HpexQ17E99_!!2208368159200-0-cib.jpg\"/></p>\r\n<p><img src=\"https://cbu01.alicdn.com/img/ibank/O1CN01Pl4xZ52HpexPoonrm_!!2208368159200-0-cib.jpg\"/></p>\r\n<p><img src=\"https://cbu01.alicdn.com/img/ibank/O1CN017Wp1KN2HpexPsSqz2_!!2208368159200-0-cib.jpg\"/>