var offer_details={"content":"<div id=\"offer-template-0\"></div><div style=\"width: 790.0px;\">\r\n        \r\n        <div class=\"rich-text-component\" style=\"width: 395.0px;padding: 10.0px;word-break: break-all;white-space: break-spaces;font-family: ali-webfont;zoom: 2;font-size: 0.0px;box-sizing: border-box;\"><p><span style=\"font-size: 16.0px;color: #f44336;background-color: #ffeb3b;\">成品尺寸：30*17*19.6CM；</span></p><p><span style=\"font-size: 16.0px;color: #f44336;background-color: #ffeb3b;\">包装：34X23X7CM</span></p><p><span style=\"font-size: 16.0px;color: #f44336;background-color: #ffeb3b;\">加厚箱箱装：77*38*48CM</span></p><p><span style=\"font-size: 16.0px;color: #f44336;background-color: #ffeb3b;\">单盒重量：1.4KG；</span></p><p><span style=\"font-size: 16.0px;color: #f44336;background-color: #ffeb3b;\">装箱规格：一箱20盒！</span></p><p><span style=\"font-size: 16.0px;color: #f44336;background-color: #ffeb3b;\">标配：LED灯+电池盒开关+1支白乳胶</span></p><p><span style=\"font-size: 16.0px;\">&nbsp;</span></p><p><span style=\"font-size: 16.0px;\">工具；胶水；配件链接：</span></p><p><a href=\"https://detail.1688.com/offer/621727216879.html?spm=a26286.8251493.description.2.221425b2WBIGaZ\" rel=\"noopener noreferrer\" target=\"_blank\" style=\"font-size: 16.0px;\">https://detail.1688.com/offer/621727216879.html?spm=a26286.8251493.description.2.221425b2WBIGaZ</a></p><p><span style=\"font-size: 16.0px;\">人偶公仔链接：</span></p><p><a href=\"https://detail.1688.com/offer/622098261430.html?spm=a26286.8251493.description.2.221425b2WBIGaZ\" rel=\"noopener noreferrer\" target=\"_blank\" style=\"font-size: 16.0px;\">https://detail.1688.com/offer/622098261430.html?spm=a26286.8251493.description.2.221425b2WBIGaZ</a></p><p><span style=\"font-size: 16.0px;\">&nbsp;&nbsp;因diy小屋零件较多，只能人工分装，少数产品可能有零部件遗漏，因批发利润微薄，需补材料的批发客户请统计好需要补发的零部件编号（具体编号参考说明书）和数量，下次订货时一起发出！客人做坏了材料，需要单独补的，请拍补材料的链接，联系客服补发！谢谢理解和支持！</span></p></div>\r\n        \r\n        \r\n    \r\n        \r\n         <img src=\"https://cbu01.alicdn.com/img/ibank/O1CN01bHZ3